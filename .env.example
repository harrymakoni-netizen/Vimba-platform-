# Copy to .env.local (git-ignored). `npm run keys:generate` fills the secrets for development.
DATABASE_URL=postgres://vimba_owner:owner@127.0.0.1:5432/vimba
VIMBA_BASE_URL=http://localhost:3000
VIMBA_ISSUER_ID=vimba-demo-issuer
# Ed25519 signing key (PEM or base64 PEM). Server-side only.
VIMBA_SIGNING_KEY_ID=
VIMBA_SIGNING_PRIVATE_KEY=
VIMBA_SIGNING_PUBLIC_KEY=
VIMBA_APP_SECRET=
VIMBA_WORKER_SECRET=
CHANNEL_SENDER_PEPPER=
# Kapso / WhatsApp (optional; the labelled simulator works without them)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
WHATSAPP_PUBLIC_NUMBER=
WHATSAPP_SOFT_CAP=1600
# Shona and Ndebele packs are drafts. Set to false in a pilot until a fluent reviewer signs them off.
VIMBA_ALLOW_DRAFT_LOCALES=true
